              },
              "mapper": {
                "ca": "",
                "qs": [],
                "url": "<MAKE_WEBHOOK_SCOUT_5_DAY_SUMMARY>",
                "data": "{\"check_in_id\":\"{{1.check_in_id}}\"}",
                "gzip": true,
                "method": "post",
