                    "value": "application/json"
                  }
                ]
              },
              "metadata": {
                "designer": {
                  "x": 2100,
                  "y": 300,
                  "name": "answer the interface"
                }
              }
            },
            {
              "id": 23,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": {
                "handleErrors": false,
