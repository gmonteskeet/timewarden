              },
              "metadata": {
                "designer": {
                  "x": 1500,
                  "y": 300,
                  "name": "save the closing line"
                }
              }
            },
            {
              "id": 14,
              "module": "json:CreateJSON",
              "version": 1,
              "parameters": {
                "type": "<DS_scout_interview_response>",
                "space": ""
              },
              "mapper": {
                "ok": true,
                "done": true,
                "turn_no": "{{3.data.next_turn_no}}",
                "question": "Thank you {{3.data.first_name}}, that gives me a clear picture of your day and your summary is ready.",
                "kind": "closing",
                "evidence": ""
              },
              "metadata": {
                "designer": {
                  "x": 1800,
                  "y": 300,
                  "name": "build the reply"
                }
              }
            },
