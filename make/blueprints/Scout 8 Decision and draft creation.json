                "serializeUrl": false,
                "shareCookies": false,
                "parseResponse": false,
                "stopOnHttpError": true,
                "followRedirect": true,
                "useQuerystring": false,
                "followAllRedirects": false,
                "rejectUnauthorized": true
              },
              "metadata": {
                "designer": {
                  "x": 1500,
                  "y": 300,
                  "name": "mark the suggestion approved"
                }
              }
            },
            {
              "id": 13,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": {
                "handleErrors": false,
                "useNewZLibDeCompress": true
              },
              "mapper": {
                "ca": "",
                "qs": [],
                "url": "<SUPABASE_URL>/rest/v1/people?company_id=eq.{{get(first(2.data); \"company_id\")}}&app_role=eq.employee&select=full_name,email&order=full_name",
                "data": "",
                "gzip": true,
                "method": "get",
                "headers": [
                  {
                    "name": "apikey",
                    "value": "<SUPABASE_SERVICE_ROLE_KEY>"
                  },
                  {
                    "name": "Authorization",
                    "value": "Bearer <SUPABASE_SERVICE_ROLE_KEY>"
                  },
                  {
                    "name": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "timeout": "",
                "useMtls": false,
                "authPass": "",
                "authUser": "",
                "bodyType": "raw",
                "contentType": "application/json",
                "serializeUrl": false,
                "shareCookies": false,
                "parseResponse": true,
                "stopOnHttpError": true,
                "followRedirect": true,
                "useQuerystring": false,
                "followAllRedirects": false,
                "rejectUnauthorized": true
              },
              "metadata": {
                "designer": {
                  "x": 1800,
                  "y": 300,
                  "name": "read the people who do this work"
                }
              }
            },
            {
              "id": 14,
              "module": "util:SetVariable2",
              "version": 1,
              "parameters": {},
              "mapper": {
                "name": "draft_prompt",
                "scope": "roundtrip",
                "value": "<THE WHOLE OF prompts/05_draft_workflow_fill.md>"
              },
              "metadata": {
                "designer": {
                  "x": 2100,
                  "y": 300,
                  "name": "the draft filling prompt"
                }
              }
            },
            {
              "id": 15,
              "module": "json:CreateJSON",
              "version": 1,
              "parameters": {
                "type": "<DS_scout_draft_prompt_input>",
                "space": ""
              },
              "mapper": {
                "candidate": {
                  "title": "{{get(first(2.data); \"title\")}}",
                  "description": "{{get(first(2.data); \"description\")}}",
                  "source_label": "{{get(first(2.data); \"source_label\")}}",
                  "people_affected": "{{get(first(2.data); \"people_affected\")}}",
                  "hours_per_week": "{{get(first(2.data); \"hours_per_week\")}}",
                  "reasoning": "{{get(first(2.data); \"reasoning\")}}",
                  "proposed_steps": "{{get(first(2.data); \"proposed_steps\")}}"
                },
                "template_description": "Weekly schedule. Google Sheets Search rows reads every row of one sheet. Anthropic Claude Create a message writes a summary of those rows following summary_prompt. Gmail Create a draft puts the summary in a draft email to recipients. The scenario is created switched off.",
                "contacts": "{{13.data}}"
              },
              "metadata": {
                "designer": {
                  "x": 2400,
                  "y": 300,
                  "name": "build the input for Claude"
                }
              }
            },
            {
              "id": 16,
              "module": "anthropic-claude:createAMessage",
              "version": 1,
              "parameters": {
                "__IMTCONN__": "<ANTHROPIC_CONNECTION_ID>"
              },
              "mapper": {
                "model": "claude-sonnet-4-5",
                "max_tokens": 1500,
                "temperature": 0.2,
                "system": "{{14.draft_prompt}}",
                "messages": [
                  {
                    "role": "user",
                    "inputType": "single",
                    "content": "{{15.json}}"
                  }
                ]
              },
              "metadata": {
                "designer": {
                  "x": 2700,
                  "y": 300,
                  "name": "fill the template"
                }
              },
              "onerror": [
                {
                  "id": 30,
                  "module": "gateway:WebhookRespond",
                  "version": 1,
                  "parameters": {},
                  "mapper": {
                    "status": 200,
                    "body": "{\"ok\":false,\"message\":\"Claude could not be reached, so no draft was made. The approval is saved, so you can try again.\"}",
                    "headers": [
                      {
                        "key": "Content-Type",
                        "value": "application/json"
                      }
                    ]
                  },
                  "metadata": {
                    "designer": {
                      "x": 2700,
                      "y": 600,
                      "name": "tell the interface it failed"
                    }
                  }
                }
              ]
            },
            {
              "id": 17,
              "module": "json:ParseJSON",
              "version": 1,
              "parameters": {
                "type": "<DS_scout_draft_fill_reply>"
              },
              "mapper": {
                "json": "{{trim(replace(first(map(16.content; \"text\"; \"type\"; \"text\")); \"/```(json)?/g\"; emptystring))}}"
              },
              "metadata": {
                "designer": {
                  "x": 3000,
                  "y": 300,
                  "name": "read Claude's reply"
                }
              },
              "onerror": [
                {
                  "id": 18,
                  "module": "anthropic-claude:createAMessage",
                  "version": 1,
                  "parameters": {
                    "__IMTCONN__": "<ANTHROPIC_CONNECTION_ID>"
                  },
                  "mapper": {
                    "model": "claude-sonnet-4-5",
                    "max_tokens": 1500,
                    "temperature": 0.2,
                    "system": "{{14.draft_prompt}}\n\nReturn valid JSON only, no commentary",
                    "messages": [
                      {
                        "role": "user",
                        "inputType": "single",
                        "content": "{{15.json}}"
                      }
                    ]
                  },
                  "metadata": {
                    "designer": {
                      "x": 3000,
                      "y": 600,
                      "name": "ask again, JSON only"
                    }
                  }
                },
                {
                  "id": 19,
                  "module": "json:ParseJSON",
                  "version": 1,
                  "parameters": {
                    "type": "<DS_scout_draft_fill_reply>"
                  },
                  "mapper": {
                    "json": "{{trim(replace(first(map(18.content; \"text\"; \"type\"; \"text\")); \"/```(json)?/g\"; emptystring))}}"
                  },
                  "metadata": {
                    "designer": {
                      "x": 3300,
                      "y": 600,
                      "name": "read the second reply"
                    }
                  },
                  "onerror": [
                    {
                      "id": 31,
                      "module": "gateway:WebhookRespond",
                      "version": 1,
                      "parameters": {},
                      "mapper": {
                        "status": 200,
                        "body": "{\"ok\":false,\"message\":\"Claude did not return valid values for the draft twice. The approval is saved, so you can try again.\"}",
                        "headers": [
                          {
                            "key": "Content-Type",
                            "value": "application/json"
                          }
                        ]
                      },
                      "metadata": {
                        "designer": {
                          "x": 3300,
                          "y": 850,
                          "name": "tell the interface it failed"
                        }
                      }
                    }
                  ]
                },
                {
                  "id": 20,
                  "module": "builtin:Resume",
                  "version": 1,
                  "parameters": {},
                  "mapper": {
                    "scenario_name": "{{19.scenario_name}}",
                    "schedule": "{{19.schedule}}",
                    "source_sheet_name": "{{19.source_sheet_name}}",
                    "recipients": "{{19.recipients}}",
                    "summary_prompt": "{{19.summary_prompt}}"
                  },
                  "metadata": {
                    "designer": {
                      "x": 3600,
                      "y": 600,
                      "name": "carry on with the second reply"
                    }
                  }
                }
              ]
            },
            {
              "id": 21,
              "module": "json:CreateJSON",
              "version": 1,
              "parameters": {
                "type": "<DS_scout_draft_fill_reply>",
                "space": ""
              },
              "mapper": {
                "scenario_name": "{{17.scenario_name}}",
                "schedule": {
                  "day": "{{17.schedule.day}}",
                  "time": "{{17.schedule.time}}"
                },
                "source_sheet_name": "{{17.source_sheet_name}}",
                "recipients": "{{17.recipients}}",
                "summary_prompt": "{{17.summary_prompt}}"
              },
              "metadata": {
                "designer": {
                  "x": 3300,
                  "y": 300,
                  "name": "the values for the draft"
                }
              }
            },
            {
              "id": 32,
              "module": "gateway:WebhookRespond",
              "version": 1,
              "parameters": {},
              "mapper": {
                "status": 200,
                "body": "{\"ok\": true, \"draft_values\": {{21.json}}}",
                "headers": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ]
              },
              "metadata": {
                "designer": {
                  "x": 3600,
                  "y": 300,
                  "name": "answer the interface"
                }
              }
            }
          ]
        }
      ]
    }
  ],
