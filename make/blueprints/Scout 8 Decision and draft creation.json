{
  "_readme": "Exported from the live scenario with every key, token, webhook address and private id replaced by a named placeholder. The step that creates the draft scenario is added by scripts/set_scout8_token.mjs, which puts the make.com token straight into that one header. It is not in this export. The prompt text is not repeated here: it is the file named in the Set variable module, word for word. Data structure ids are the account's own and are written as <DS_...>.",
  "name": "Scout 8: Decision and draft creation",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {
        "hook": "<HOOK_ID>",
        "maxResults": 1
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0,
          "name": "Scout 8 decision and draft"
        }
      }
    },
    {
      "id": 2,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {
        "handleErrors": false,
        "useNewZLibDeCompress": true
      },
      "mapper": {
        "ca": "",
        "qs": [],
        "url": "<SUPABASE_URL>/rest/v1/candidates?id=eq.{{1.candidate_id}}&select=*",
        "data": "",
        "gzip": true,
        "method": "get",
        "headers": [
          {
            "name": "apikey",
            "value": "<SUPABASE_SERVICE_ROLE_KEY>"
          },
          {
            "name": "Authorization",
            "value": "Bearer <SUPABASE_SERVICE_ROLE_KEY>"
          },
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "timeout": "",
        "useMtls": false,
        "authPass": "",
        "authUser": "",
        "bodyType": "raw",
        "contentType": "application/json",
        "serializeUrl": false,
        "shareCookies": false,
        "parseResponse": true,
        "stopOnHttpError": true,
        "followRedirect": true,
        "useQuerystring": false,
        "followAllRedirects": false,
        "rejectUnauthorized": true
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0,
          "name": "read the suggestion"
        }
      },
      "filter": {
        "name": "only our own interface",
        "conditions": [
          [
            {
              "a": "{{first(map(1.__IMTHEADERS__; \"value\"; \"name\"; \"x-scout-key\"))}}",
              "o": "text:equal",
              "b": "<SCOUT_SHARED_SECRET>"
            }
          ]
        ]
      }
    },
    {
      "id": 3,
      "module": "builtin:BasicRouter",
      "version": 1,
      "mapper": null,
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0,
          "name": "what kind of decision is this"
        }
      },
      "routes": [
        {
          "flow": [
            {
              "id": 4,
              "module": "gateway:WebhookRespond",
              "version": 1,
              "parameters": {},
              "mapper": {
                "status": 200,
                "body": "{\"ok\":false,\"message\":\"There is no suggestion with that id.\"}",
                "headers": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ]
              },
              "metadata": {
                "designer": {
                  "x": 900,
                  "y": -450,
                  "name": "tell the interface it is not there"
                }
              },
              "filter": {
                "name": "the suggestion is not there",
                "conditions": [
                  [
                    {
                      "a": "{{length(2.data)}}",
                      "o": "number:equal",
                      "b": "0"
                    }
                  ]
                ]
              }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 5,
              "module": "gateway:WebhookRespond",
              "version": 1,
              "parameters": {},
              "mapper": {
                "status": 200,
                "body": "{\"ok\": true, \"make_scenario_url\": \"{{get(first(2.data); \\\"make_scenario_url\\\")}}\"}",
                "headers": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ]
              },
              "metadata": {
                "designer": {
                  "x": 900,
                  "y": -250,
                  "name": "hand back the draft that exists"
                }
              },
              "filter": {
                "name": "there is already a draft",
                "conditions": [
                  [
                    {
                      "a": "{{length(2.data)}}",
                      "o": "number:greater",
                      "b": "0"
                    },
                    {
                      "a": "{{ifempty(get(first(2.data); \"make_scenario_url\"); \"none\")}}",
                      "o": "text:notequal",
                      "b": "none"
                    }
                  ]
                ]
              }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 6,
              "module": "json:CreateJSON",
              "version": 1,
              "parameters": {
                "type": "<DS_scout_approval_row>",
                "space": ""
              },
              "mapper": {
                "candidate_id": "{{1.candidate_id}}",
                "approver_id": "{{1.approver_id}}",
                "decision": "rejected",
                "comment": "{{1.comment}}"
              },
              "metadata": {
                "designer": {
                  "x": 900,
                  "y": 0,
                  "name": "build the approval row"
                }
              },
              "filter": {
                "name": "not now",
                "conditions": [
                  [
                    {
                      "a": "{{length(2.data)}}",
                      "o": "number:greater",
                      "b": "0"
                    },
                    {
                      "a": "{{ifempty(get(first(2.data); \"make_scenario_url\"); \"none\")}}",
                      "o": "text:equal",
                      "b": "none"
                    },
                    {
                      "a": "{{1.decision}}",
                      "o": "text:equal",
                      "b": "rejected"
                    }
                  ]
                ]
              }
            },
            {
              "id": 7,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": {
                "handleErrors": false,
                "useNewZLibDeCompress": true
              },
              "mapper": {
                "ca": "",
                "qs": [],
                "url": "<SUPABASE_URL>/rest/v1/approvals",
                "data": "{{6.json}}",
                "gzip": true,
                "method": "post",
                "headers": [
                  {
                    "name": "apikey",
                    "value": "<SUPABASE_SERVICE_ROLE_KEY>"
                  },
                  {
                    "name": "Authorization",
                    "value": "Bearer <SUPABASE_SERVICE_ROLE_KEY>"
                  },
                  {
                    "name": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "timeout": "",
                "useMtls": false,
                "authPass": "",
                "authUser": "",
                "bodyType": "raw",
                "contentType": "application/json",
                "serializeUrl": false,
                "shareCookies": false,
                "parseResponse": false,
                "stopOnHttpError": true,
                "followRedirect": true,
                "useQuerystring": false,
                "followAllRedirects": false,
                "rejectUnauthorized": true
              },
              "metadata": {
                "designer": {
                  "x": 1200,
                  "y": 0,
                  "name": "record the decision"
                }
              }
            },
            {
              "id": 8,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": {
                "handleErrors": false,
                "useNewZLibDeCompress": true
              },
              "mapper": {
                "ca": "",
                "qs": [],
                "url": "<SUPABASE_URL>/rest/v1/candidates?id=eq.{{1.candidate_id}}",
                "data": "{\"status\":\"rejected\"}",
                "gzip": true,
                "method": "patch",
                "headers": [
                  {
                    "name": "apikey",
                    "value": "<SUPABASE_SERVICE_ROLE_KEY>"
                  },
                  {
                    "name": "Authorization",
                    "value": "Bearer <SUPABASE_SERVICE_ROLE_KEY>"
                  },
                  {
                    "name": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "timeout": "",
                "useMtls": false,
                "authPass": "",
                "authUser": "",
                "bodyType": "raw",
                "contentType": "application/json",
                "serializeUrl": false,
                "shareCookies": false,
                "parseResponse": false,
                "stopOnHttpError": true,
                "followRedirect": true,
                "useQuerystring": false,
                "followAllRedirects": false,
                "rejectUnauthorized": true
              },
              "metadata": {
                "designer": {
                  "x": 1500,
                  "y": 0,
                  "name": "mark the suggestion rejected"
                }
              }
            },
            {
              "id": 9,
              "module": "gateway:WebhookRespond",
              "version": 1,
              "parameters": {},
              "mapper": {
                "status": 200,
                "body": "{\"ok\": true}",
                "headers": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ]
              },
              "metadata": {
                "designer": {
                  "x": 1800,
                  "y": 0,
                  "name": "answer the interface"
                }
              }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 10,
              "module": "json:CreateJSON",
              "version": 1,
              "parameters": {
                "type": "<DS_scout_approval_row>",
                "space": ""
              },
              "mapper": {
                "candidate_id": "{{1.candidate_id}}",
                "approver_id": "{{1.approver_id}}",
                "decision": "approved",
                "comment": "{{1.comment}}"
              },
              "metadata": {
                "designer": {
                  "x": 900,
                  "y": 300,
                  "name": "build the approval row"
                }
              },
              "filter": {
                "name": "approved",
                "conditions": [
                  [
                    {
                      "a": "{{length(2.data)}}",
                      "o": "number:greater",
                      "b": "0"
                    },
                    {
                      "a": "{{ifempty(get(first(2.data); \"make_scenario_url\"); \"none\")}}",
                      "o": "text:equal",
                      "b": "none"
                    },
                    {
                      "a": "{{1.decision}}",
                      "o": "text:equal",
                      "b": "approved"
                    }
                  ]
                ]
              }
            },
            {
              "id": 11,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": {
                "handleErrors": false,
                "useNewZLibDeCompress": true
              },
              "mapper": {
                "ca": "",
                "qs": [],
                "url": "<SUPABASE_URL>/rest/v1/approvals",
                "data": "{{10.json}}",
                "gzip": true,
                "method": "post",
                "headers": [
                  {
                    "name": "apikey",
                    "value": "<SUPABASE_SERVICE_ROLE_KEY>"
                  },
                  {
                    "name": "Authorization",
                    "value": "Bearer <SUPABASE_SERVICE_ROLE_KEY>"
                  },
                  {
                    "name": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "timeout": "",
                "useMtls": false,
                "authPass": "",
                "authUser": "",
                "bodyType": "raw",
                "contentType": "application/json",
                "serializeUrl": false,
                "shareCookies": false,
                "parseResponse": false,
                "stopOnHttpError": true,
                "followRedirect": true,
                "useQuerystring": false,
                "followAllRedirects": false,
                "rejectUnauthorized": true
              },
              "metadata": {
                "designer": {
                  "x": 1200,
                  "y": 300,
                  "name": "record the decision"
                }
              }
            },
            {
              "id": 12,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": {
                "handleErrors": false,
                "useNewZLibDeCompress": true
              },
              "mapper": {
                "ca": "",
                "qs": [],
                "url": "<SUPABASE_URL>/rest/v1/candidates?id=eq.{{1.candidate_id}}",
                "data": "{\"status\":\"approved\"}",
                "gzip": true,
                "method": "patch",
                "headers": [
                  {
                    "name": "apikey",
                    "value": "<SUPABASE_SERVICE_ROLE_KEY>"
                  },
                  {
                    "name": "Authorization",
                    "value": "Bearer <SUPABASE_SERVICE_ROLE_KEY>"
